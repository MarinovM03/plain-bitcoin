{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "files": {
        "includes": [
            "**",
            "!**/dist",
            "!**/node_modules",
            "!**/test-results",
            "!**/playwright-report",
            "!**/.lighthouse",
            "!**/src/data/prices/daily-*.json",
            "!**/*.svg"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "trailingCommas": "all",
            "semicolons": "always"
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "correctness": {
                "useImportExtensions": "error"
            }
        }
    },
    "assist": {
        "enabled": true
    }
}
