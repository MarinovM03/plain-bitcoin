{
    "name": "plain-bitcoin",
    "private": true,
    "version": "0.1.0",
    "description": "A few honest Bitcoin tools, fast and plain.",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "npm run typecheck && vite build",
        "preview": "vite preview --port 4173 --strictPort",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "lint": "biome check ."
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@playwright/test": "1.63.0",
        "@types/node": "^22.20.4",
        "typescript": "^7.0.2",
        "vite": "^8.3.1",
        "vitest": "^5.0.2"
    }
}
